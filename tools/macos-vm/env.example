### Optional environment overrides for tools/macos-vm scripts

# DATA_DIR=/workspace/data/macos-vm
# MACOS_SHORTNAME=sonoma

# DISK_SIZE=128G
# SYSTEM_DISK=/workspace/data/macos-vm/disks/mac_hdd_ng.img

# ALLOCATED_RAM=8192
# CPU_SOCKETS=1
# CPU_CORES=2
# CPU_THREADS=4
# CPU_MODEL=Penryn
# CPU_EXTRA=vmware-cpuid-freq=on

# VNC_DISPLAY=51
# VNC_PORT=5951
# NOVNC_PORT=6080
# SSH_FORWARD_PORT=2222

# INSTALL_MEDIA=1
# OFFLINE_ISO=/workspace/data/macos-vm/offline/InstallAssistant.iso
# EXTRA_QEMU_ARGS="-serial none"
